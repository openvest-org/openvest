{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openvest.org/schemas/question.schema.json",
  "title": "OpenVest question",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "area", "statement", "supportText", "alternatives", "correctAlternative", "references", "media", "sharedStimulusIds", "source", "provenance"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "area": { "type": "string", "minLength": 1 },
    "statement": { "type": "string", "minLength": 1 },
    "supportText": { "type": "string" },
    "alternatives": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text"],
        "properties": {
          "id": { "enum": ["A", "B", "C", "D", "E"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "correctAlternative": { "enum": ["A", "B", "C", "D", "E"] },
    "references": { "type": "array", "items": { "type": "string" } },
    "media": { "type": "array", "items": { "$ref": "#/$defs/media" } },
    "sharedStimulusIds": { "type": "array", "items": { "type": "string" } },
    "source": { "$ref": "#/$defs/source" },
    "provenance": { "$ref": "#/$defs/provenance" }
  },
  "$defs": {
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "alt"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["image", "vector", "mixed", "unknown"] },
        "path": { "type": "string", "pattern": "^/content/" },
        "alt": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exam", "examId", "year", "day", "booklet", "color", "number", "language", "filename", "sha256"],
      "properties": {
        "exam": { "type": "string", "minLength": 1 },
        "examId": { "type": "string", "minLength": 1 },
        "year": { "type": "integer" },
        "day": { "enum": [1, 2] },
        "booklet": { "type": "integer" },
        "color": { "type": "string" },
        "number": { "type": "integer" },
        "language": { "enum": ["en", "es", null] },
        "filename": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extractor", "extractorVersion", "confidence", "warnings"],
      "properties": {
        "extractor": { "const": "enem-extractor" },
        "extractorVersion": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
